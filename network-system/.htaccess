# حماية الملفات الحساسة وتوجيه كل الطلبات إلى مجلد public
Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|cli|config|database|storage|tests|deploy|hotspot-sdk)(/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
<FilesMatch "\.(md|sql|log|lock|json|sh|dist)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
