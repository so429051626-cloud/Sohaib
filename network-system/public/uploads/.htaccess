# منع تنفيذ أي سكربت داخل مجلد الرفع
Options -Indexes -ExecCGI
<FilesMatch "\.(php|phtml|php[0-9]|phar|pl|py|cgi|sh|htm|html|svg)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
